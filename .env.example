# Supabase — public (exposed to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — private (server-side only, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email (Resend) — server-side only
RESEND_API_KEY=

# OCR (Google Vision) — server-side only
GOOGLE_VISION_CREDENTIALS=

# Admin
ADMIN_EMAIL=

# Private finance areas (server-side only)
PRIVATE_FINANCE_ACCOUNT_EMAIL=

# Aurora 6.0 financial assistant foundations (server-side, fail-closed)
FINANCIAL_ASSISTANT_ENABLED=false

# Aurora 6.0 controlled AI provider (server-side only, optional, fail-closed)
FINANCIAL_ASSISTANT_AI_ENABLED=false
FINANCIAL_ASSISTANT_AI_PROVIDER=openai
FINANCIAL_ASSISTANT_AI_MODEL=
FINANCIAL_ASSISTANT_AI_TIMEOUT_MS=12000
FINANCIAL_ASSISTANT_AI_MAX_INPUT_CHARS=4000
FINANCIAL_ASSISTANT_AI_MAX_OUTPUT_TOKENS=800
OPENAI_API_KEY=
